#!/bin/zsh

emulate -L zsh
local editor_sock="$HOME/.cache/wezterm/nb-editor.sock"
local list_cmd='nb list --no-color -t note'
local reload_action="reload($list_cmd)"

# ─── fzf action bindings ───
# {1} expands to the first whitespace field = "[N]" (brackets included),
# so strip them in the child shell before passing to nb.
local extract_id='id={1}; id=${id#\[}; id=${id%\]}'
local bind_delete="ctrl-d:execute-silent(${extract_id}; nb delete \"\$id\" -f)+${reload_action}"
# Rename uses zsh -c for reliable UTF-8 input via zsh's read builtin.
local bind_rename=$'ctrl-s:execute(zsh -c \'id=$1; id=${id#\\[}; id=${id%\\]}; read "new?rename to: "; [[ -n "$new" ]] && nb move "$id" "$new" -f\' _ {1})+'"${reload_action}"
local bind_reload="ctrl-r:${reload_action}"
local preview_cmd="${extract_id}; batcat --color=always --style=plain --paging=never \"\$(nb show \"\$id\" --path 2>/dev/null)\" 2>/dev/null"

while :; do
  local line
  line=$(
    eval "$list_cmd" | fzf \
      --height=100% \
      --prompt='nb> ' \
      --header 'enter:edit  C-d:del  C-s:rename  C-r:reload' \
      --preview "$preview_cmd" \
      --preview-window='right:40%' \
      --bind "$bind_delete" \
      --bind "$bind_rename" \
      --bind "$bind_reload"
  ) || return 0
  [[ -z "$line" ]] && continue

  local id="${${line%%\]*}#\[}"
  [[ -z "$id" ]] && continue

  local note_path
  note_path=$(nb show "$id" --path 2>/dev/null) || continue

  nvim --server "$editor_sock" --remote "$note_path" </dev/null >/dev/null 2>&1

  # Drain any stale terminal responses (e.g., DA1 from nvim's TTY probe)
  # otherwise they get interpreted as fzf query input on the next iteration
  local _drain
  while read -t 0 -k 1 -s _drain 2>/dev/null; do :; done

  local editor_pane_id
  editor_pane_id=$(<"$HOME/.cache/wezterm/nb-editor.pane-id")
  [[ -n "$editor_pane_id" ]] && wezterm.exe cli activate-pane --pane-id "$editor_pane_id" 2>/dev/null
done
